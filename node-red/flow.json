  },
  {
    "id": "splitStatus",
    "type": "function",
    "z": "tab1",
    "name": "Split Dashboard Data",
    "func": "const p = msg.payload || {};\nconst current = Number(p.current || 0);\nconst max = Number(p.max || 0);\nconst status = String(p.status || (max > 0 && current >= max ? 'FULL' : 'AVAILABLE'));\n\nconst mIn = { payload: Number(p.in || 0) };\nconst mOut = { payload: Number(p.out || 0) };\nconst mCurrent = { payload: current };\nconst mMax = { payload: max };\nconst mStatus = { payload: status === 'FULL' ? '🔴 ĐÃ ĐẦY' : '🟢 CÒN CHỖ' };\nmStatus.ui_update = { color: status === 'FULL' ? '#d32f2f' : '#2e7d32' };\nconst mChart = { payload: current, topic: 'CURRENT' };\n\nreturn [mIn, mOut, mCurrent, mMax, mStatus, mChart];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 100,
    "wires": [["uiIn"], ["uiOut"], ["uiCurrent"], ["uiMax", "uiMaxSlider"], ["uiStatus"], ["uiChart"]]
  },
