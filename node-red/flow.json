  {
    "id": "prepareMax",
    "type": "function",
    "z": "tab1",
    "name": "Prepare SET MAX",
    "func": "let value = Number(msg.payload);\nif (!Number.isFinite(value)) return null;\nvalue = Math.round(value);\nif (value < 1 || value > 999) return null;\nmsg.payload = String(value);\nmsg.topic = 'nhom17/people/cmd/max';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 470,
    "wires": [["mqttOut"]]
  },
