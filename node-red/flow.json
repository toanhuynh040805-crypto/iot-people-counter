    "id": "statusFn",
    "type": "function",
    "z": "tab1",
    "name": "Check Capacity",
    "func": "const p = msg.payload || {};\nconst current = Number(p.current || 0);\nconst max = Number(p.max || 0);\nmsg.payload = {\n  ...p,\n  alert: max > 0 && current >= max,\n  message: max > 0 && current >= max ? 'KHU VUC DA DAY' : 'CON CHO'\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
