  {
    "id": "formatEvent",
    "type": "function",
    "z": "tab1",
    "name": "Format Latest Event",
    "func": "const p = msg.payload || {};\nconst e = String(p.event || '-');\nif (e === 'IN') msg.payload = '⬇️ KHÁCH VÀO';\nelse if (e === 'OUT') msg.payload = '⬆️ KHÁCH RA';\nelse if (e === 'RESET') msg.payload = '↺ RESET';\nelse if (e === 'SET_MAX') msg.payload = '⚙️ ĐỔI MAX';\nelse msg.payload = e;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 240,
    "wires": [["uiEvent"]]
  },
